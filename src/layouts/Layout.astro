---
const { title = 'Viso — Marketing that moves you forward', active = 'Home' } = Astro.props;
const nav = [
  { label: 'Home', href: '/' }, { label: 'Services', href: '/services' },
  { label: 'Customer', href: '/customer' }, { label: 'Pricing', href: '/pricing' },
  { label: 'Blog', href: '/blog' }, { label: 'Contact', href: '/contact' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafaff" />
    <meta name="description" content="Viso is a creative marketing studio helping ambitious brands find their people and grow." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Viso home"><span class="brand-mark"><svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="16" cy="16" r="16" fill="currentColor"/><path d="M16 7.3a5 5 0 0 0-5 5v2.1a7.3 7.3 0 0 0-2.2 5.2v1.1h14.4v-1.1a7.3 7.3 0 0 0-2.2-5.2v-2.1a5 5 0 0 0-5-5Z" fill="white"/></svg></span><span class="brand-name">VISO</span></a>
      <button class="menu-toggle" aria-label="Open menu" aria-expanded="false"><span></span><span></span><span></span></button>
      <nav class="main-nav" aria-label="Main navigation">
        {nav.map((item) => <a class:list={[{ active: active === item.label }]} href={item.href}>{item.label}</a>)}
      </nav>
      <a class="phone-pill" href="tel:+8801234567"><span>↗</span> +880 1234 567</a>
    </header>
    <main><slot /></main>
    <footer class="site-footer"><a class="brand footer-brand" href="/"><span class="brand-mark"><svg viewBox="0 0 32 32" fill="none"><circle cx="16" cy="16" r="16" fill="currentColor"/><path d="M16 7.3a5 5 0 0 0-5 5v2.1a7.3 7.3 0 0 0-2.2 5.2v1.1h14.4v-1.1a7.3 7.3 0 0 0-2.2-5.2v-2.1a5 5 0 0 0-5-5Z" fill="white"/></svg></span><span class="brand-name">VISO</span></a><p>Good ideas deserve to go places.</p><div class="footer-links">{nav.map((item) => <a href={item.href}>{item.label}</a>)}</div><small>© 2025 Viso Studio. Made with intention.</small></footer>
    <script>
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('.main-nav');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('open', !open);
      });
    </script>
  </body>
</html>

<style is:global>
  :root{font-family:'DM Sans',sans-serif;color:#17164e;background:#fff;font-synthesis:none;text-rendering:optimizeLegibility;--ink:#19184f;--muted:#7884a9;--coral:#ff4039;--lav:#c6c9ff;--line:#ebeaf4}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-width:320px}a{color:inherit;text-decoration:none}.site-header{height:78px;width:min(100% - 48px,1120px);margin:auto;display:flex;align-items:center;justify-content:space-between;position:relative;z-index:5}.brand{display:flex;flex-direction:column;align-items:center;gap:2px;line-height:1}.brand-mark{color:var(--coral);width:29px;height:29px}.brand-mark svg{width:100%;height:100%}.brand-name{font-size:13px;font-weight:800;letter-spacing:-.4px}.main-nav{display:flex;align-items:center;gap:32px}.main-nav a{font-size:11px;font-weight:700;text-transform:uppercase;color:#9294ab;transition:color .2s}.main-nav a:hover,.main-nav a.active{color:var(--coral)}.main-nav a.active:before{content:'';display:block;width:12px;height:2px;background:var(--coral);margin:0 auto 8px}.phone-pill,.button{border:0;border-radius:999px;background:var(--coral);color:white;box-shadow:0 5px 12px #ff403932;font-weight:700}.phone-pill{padding:13px 23px;font-size:11px}.phone-pill span{margin-right:5px}.menu-toggle{display:none}.site-footer{margin-top:70px;padding:52px 24px 28px;background:#f8f8ff;text-align:center}.footer-brand{width:max-content;margin:0 auto 12px}.site-footer p{color:var(--muted);font-size:14px}.footer-links{display:flex;justify-content:center;gap:24px;margin:26px auto}.footer-links a{font-size:12px;color:#747a99}.site-footer small{color:#a2a4b8;font-size:11px}.button{display:inline-flex;align-items:center;justify-content:center;padding:15px 27px;font-size:12px;transition:transform .2s,box-shadow .2s}.button:hover{transform:translateY(-2px);box-shadow:0 8px 18px #ff403944}.button.lavender{background:#c7caff;color:var(--ink);box-shadow:none}.eyebrow{color:var(--coral);font-size:11px;letter-spacing:2px;text-transform:uppercase;font-weight:800}.page-hero{padding:88px 24px 82px;text-align:center;background:radial-gradient(ellipse at 50% 5%,#f5f5ff,transparent 70%)}.page-hero h1{font-size:clamp(38px,6vw,64px);line-height:1.08;letter-spacing:-2.5px;max-width:800px;margin:15px auto 18px}.page-hero p{max-width:580px;margin:0 auto;color:var(--muted);line-height:1.8}.section{padding:72px 24px}.section-inner{width:min(100%,1060px);margin:auto}.section-heading{text-align:center;margin:0 auto 44px;max-width:570px}.section-heading h2{font-size:32px;letter-spacing:-1px;margin:0 0 12px}.section-heading p{color:var(--muted);font-size:14px;line-height:1.8}.section-heading:after{content:'';display:block;width:62px;height:3px;background:var(--coral);margin:18px auto}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.card{padding:30px;border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:0 12px 35px #20204d08}.card h3{font-size:17px;margin:18px 0 9px}.card p{font-size:13px;color:var(--muted);line-height:1.8;margin:0}.icon-box{width:44px;height:44px;border-radius:12px;display:grid;place-items:center;background:#fff1f0;color:var(--coral);font-size:21px}.icon-box.blue{background:#eff8ff;color:#55b6e8}.icon-box.purple{background:#f3efff;color:#9a81f6}.split{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:60px}.split h2{font-size:34px;line-height:1.2;letter-spacing:-1px;margin:12px 0}.split p{color:var(--muted);line-height:1.9}.soft-panel{min-height:320px;border-radius:28px;background:linear-gradient(145deg,#f0f1ff,#fff1ed);display:grid;place-items:center;position:relative;overflow:hidden}.soft-panel:before,.soft-panel:after{content:'';position:absolute;width:190px;height:190px;border-radius:50%;background:#c8ceff80;top:-50px;right:-20px}.soft-panel:after{width:140px;height:140px;background:#ffaca36e;top:auto;right:auto;bottom:-35px;left:-20px}.panel-emoji{position:relative;z-index:1;font-size:96px;filter:drop-shadow(0 12px 10px #28255c20)}.contact-box{padding:42px;border-radius:22px;background:#f8f8ff}.contact-form{display:grid;gap:15px}.contact-form label{font-size:12px;font-weight:700}.contact-form input,.contact-form textarea,.contact-form select{display:block;width:100%;padding:13px 14px;margin-top:7px;border:1px solid #e7e7f0;border-radius:9px;font:inherit;background:#fff}.contact-form textarea{min-height:120px;resize:vertical}.contact-form button{cursor:pointer;font:inherit}.article-grid .card{padding:0;overflow:hidden}.article-art{height:160px;background:linear-gradient(135deg,#e1e5ff,#ffe9e4);display:grid;place-items:center;font-size:48px}.article-body{padding:22px}.article-body small{color:var(--coral);font-size:10px;text-transform:uppercase;font-weight:800;letter-spacing:1px}.price{font-size:34px;font-weight:800;margin:18px 0 4px}.price span{font-size:12px;color:var(--muted);font-weight:500}.card ul{padding-left:18px;color:var(--muted);font-size:13px;line-height:2.3}.quote{font-size:17px!important;color:var(--ink)!important}.avatar{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:#eeeaff;font-size:21px;float:left;margin-right:12px}.contact-row{display:grid;grid-template-columns:1fr 1fr;gap:18px}.contact-item{padding:23px;border:1px solid var(--line);border-radius:14px}.contact-item strong{display:block;margin-bottom:6px}.contact-item span{font-size:13px;color:var(--muted)}
  @media(max-width:760px){.site-header{height:70px;width:calc(100% - 36px)}.phone-pill{display:none}.menu-toggle{display:flex;margin-left:auto;margin-right:0;flex-direction:column;gap:5px;background:white;border:0;padding:8px}.menu-toggle span{width:22px;height:2px;background:var(--ink)}.main-nav{display:none;position:absolute;top:62px;left:0;right:0;background:#fff;padding:18px;border:1px solid var(--line);border-radius:14px;box-shadow:0 14px 30px #19184f14;align-items:stretch;gap:0;flex-direction:column}.main-nav.open{display:flex}.main-nav a{padding:12px}.main-nav a.active:before{display:none}.cards{grid-template-columns:1fr}.split{grid-template-columns:1fr;gap:30px}.split .soft-panel{grid-row:1;min-height:230px}.section{padding:56px 20px}.page-hero{padding:65px 20px}.page-hero h1{letter-spacing:-1.6px}.contact-row{grid-template-columns:1fr}.footer-links{flex-wrap:wrap;gap:12px 19px}.site-footer{margin-top:35px}}
</style>
