---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Viso — Great marketing makes customers feel smart" active="Home">
  <section class="home-hero">
    <div class="hero-inner">
      <div class="hero-copy"><span class="eyebrow">A little clarity goes a long way</span><h1>Great Marketing<br />Makes The Customer<br />Feel Smart</h1><p>We help ambitious brands turn good ideas into meaningful growth.</p><div class="hero-actions"><a class="button" href="/contact">Contact Us</a><a class="button lavender" href="/services">Our Services</a></div></div>
      <div class="hero-art" aria-label="A creative team sharing ideas"><div class="sun-shape"></div><div class="plant plant-one">✳</div><div class="plant plant-two">✿</div><div class="idea idea-one">✦</div><div class="idea idea-two">✧</div><div class="person person-left"><i></i><b></b></div><div class="person person-mid"><i></i><b></b></div><div class="person person-right"><i></i><b></b></div><div class="table-top"></div><div class="table-leg leg-left"></div><div class="table-leg leg-right"></div><div class="laptop"></div><div class="paper"></div></div>
    </div>
    <div class="side-social"><a href="/blog" aria-label="Instagram">◎</a><a href="/customer" aria-label="LinkedIn">in</a><a href="/blog" aria-label="Pinterest">℘</a></div>
    <a class="hero-arrow arrow-left" href="#process" aria-label="Scroll to our process">‹</a><a class="hero-arrow arrow-right" href="/services" aria-label="Explore our services">›</a>
  </section>
  <section class="section" id="process"><div class="section-inner"><div class="section-heading"><span class="eyebrow">A thoughtful way forward</span><h2>Our Work Process</h2><p>Good work starts with listening. Together, we find the right direction, make a clear plan, and bring your next big idea to life.</p></div><div class="cards"><article class="card"><div class="icon-box">◉</div><h3>Discover &amp; Listen</h3><p>We get to know your business, your people, and what success looks like for you.</p></article><article class="card"><div class="icon-box purple">▧</div><h3>Plan &amp; Create</h3><p>We turn insight into a practical strategy and creative that feels unmistakably yours.</p></article><article class="card"><div class="icon-box blue">↗</div><h3>Grow Together</h3><p>We launch, learn, and keep improving so your momentum carries forward.</p></article></div></div></section>
  <section class="section"><div class="section-inner split"><div><span class="eyebrow">Small team. Big ideas.</span><h2>Make room for your next great thing.</h2><p>From the first spark to the final detail, Viso brings strategy, creative, and care together in one friendly team. We make the complicated feel clear and the ambitious feel achievable.</p><a class="button" href="/services">See what we do</a></div><div class="soft-panel"><div class="panel-emoji">💡</div></div></div></section>
  <section class="section"><div class="section-inner"><div class="section-heading"><span class="eyebrow">Good company</span><h2>Kind words from our customers</h2></div><div class="cards"><article class="card"><p class="quote">“Viso helped us find a voice that finally feels like us. The whole process was thoughtful, clear, and genuinely fun.”</p><div style="margin-top:22px"><span class="avatar">👩🏻</span><strong>Maya R.</strong><p>Founder, Sunday Studio</p></div></article><article class="card"><p class="quote">“We went from a scattered idea to a brand our whole team is excited to share. I couldn’t recommend them more.”</p><div style="margin-top:22px"><span class="avatar">👨🏽</span><strong>Daniel K.</strong><p>Director, Northstar</p></div></article><article class="card"><p class="quote">“A creative partner who listens first, asks the right questions, and always brings something thoughtful to the table.”</p><div style="margin-top:22px"><span class="avatar">👩🏾</span><strong>Amara L.</strong><p>Owner, Little Fern</p></div></article></div></div></section>
  <style>
    .home-hero{min-height:410px;background:#fafaff;position:relative;display:flex;align-items:center;overflow:hidden}.hero-inner{width:min(100% - 48px,1060px);margin:0 auto;display:grid;grid-template-columns:1fr 1.05fr;align-items:center;gap:36px;padding:30px 0 52px}.hero-copy{position:relative;z-index:2}.hero-copy .eyebrow{display:none}.hero-copy h1{font-size:clamp(34px,4vw,48px);letter-spacing:-1.5px;line-height:1.2;margin:0 0 12px}.hero-copy p{color:var(--muted);font-size:14px;max-width:360px;line-height:1.7}.hero-actions{display:flex;gap:15px;margin-top:20px}.hero-art{height:330px;position:relative}.sun-shape{position:absolute;width:230px;height:230px;background:#fff1ef;border-radius:50%;top:33px;left:50%;transform:translateX(-50%)}.person{position:absolute;bottom:65px;z-index:1;width:68px;height:150px;border-radius:38px 38px 20px 20px}.person i{position:absolute;width:40px;height:47px;border-radius:48% 50% 45% 48%;top:-35px;left:12px;background:#ffb091}.person b{position:absolute;top:-39px;left:7px;width:47px;height:29px;border-radius:60% 55% 20% 20%;background:#241e65;transform:rotate(-12deg)}.person-left{left:19%;height:128px;transform:rotate(11deg);background:#7163ed}.person-left:before{content:'';position:absolute;width:18px;height:92px;border-radius:20px;background:#ffb091;transform:rotate(48deg);left:-35px;top:20px}.person-mid{left:44%;height:183px;background:#838deb;z-index:2}.person-mid i{background:#f9a18c}.person-mid b{background:#17164e}.person-right{right:14%;height:139px;transform:rotate(-8deg);background:#f34f5e}.person-right:before{content:'';position:absolute;width:18px;height:84px;border-radius:20px;background:#ffb091;transform:rotate(-42deg);right:-31px;top:18px}.table-top{position:absolute;z-index:3;bottom:53px;left:9%;width:83%;height:15px;background:#a9b7c7;transform:skew(-12deg);border-radius:3px}.table-leg{position:absolute;z-index:2;bottom:0;height:57px;width:5px;background:#8999ac;transform:rotate(12deg)}.leg-left{left:15%}.leg-right{right:13%;transform:rotate(-12deg)}.laptop{z-index:4;position:absolute;bottom:65px;left:49%;width:92px;height:59px;border-radius:6px 6px 12px 12px;background:#181750;transform:rotate(8deg);box-shadow:inset 0 0 0 3px #282661}.laptop:after{content:'';position:absolute;bottom:-7px;left:-10px;width:110px;height:8px;background:#282661;clip-path:polygon(8% 0,92% 0,100% 100%,0 100%)}.paper{position:absolute;z-index:3;bottom:75px;left:22%;width:36px;height:45px;background:repeating-linear-gradient(to bottom,#fff 0 5px,#d9def2 6px 7px);transform:rotate(-8deg)}.plant{position:absolute;color:#ff8170;font-size:42px}.plant-one{top:33px;left:8%}.plant-two{bottom:54px;right:2%;color:#b7c0ff}.idea{position:absolute;color:#bbc2ff;font-size:24px}.idea-one{top:20px;right:20%}.idea-two{top:110px;left:3%}.side-social{position:absolute;left:16px;bottom:23px;display:grid;gap:9px}.side-social a{width:21px;height:21px;display:grid;place-items:center;background:#d8dcff;color:#39377e;border-radius:4px;font-size:11px;font-weight:800}.side-social a:first-child{background:var(--coral);color:white}.hero-arrow{position:absolute;top:50%;width:48px;height:48px;border:1px solid #aaa;border-radius:50%;background:white;display:grid;place-items:center;font:30px/1 sans-serif;color:#222;transform:translateY(-50%);z-index:3}.arrow-left{left:16px}.arrow-right{right:16px}@media(max-width:760px){.home-hero{min-height:unset}.hero-inner{grid-template-columns:1fr;width:calc(100% - 40px);gap:0;padding:55px 0 35px}.hero-copy{text-align:center}.hero-copy .eyebrow{display:inline-block}.hero-copy h1{font-size:36px}.hero-copy p{margin:0 auto}.hero-actions{justify-content:center}.hero-art{height:275px;max-width:440px;width:100%;margin:5px auto 0;transform:scale(.92)}.hero-arrow,.side-social{display:none}}
  </style>
</Layout>
